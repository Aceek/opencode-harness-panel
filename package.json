{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-harness-panel",
  "version": "0.1.0",
  "description": "Configurable OpenCode TUI sidebar for inspecting session and harness state.",
  "type": "module",
  "license": "MIT",
  "author": "Aceek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aceek/opencode-harness-panel.git"
  },
  "bugs": {
    "url": "https://github.com/Aceek/opencode-harness-panel/issues"
  },
  "homepage": "https://github.com/Aceek/opencode-harness-panel#readme",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write src test scripts README.md CHANGELOG.md package.json",
    "format:check": "prettier --check src test scripts README.md CHANGELOG.md package.json",
    "check": "bun run format:check && bun run typecheck && bun run build && bun test",
    "pack:dry-run": "npm pack --dry-run",
    "test:consumer": "bun run build && bun scripts/test-consumer.ts",
    "prepack": "bun run check"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.4 <2",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.4",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.3.13",
    "prettier": "3.6.2",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  },
  "engines": {
    "bun": ">=1.2.0",
    "opencode": ">=1.18.4 <2"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "agent-harness"
  ]
}
