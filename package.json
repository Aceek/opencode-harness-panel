{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-harness-panel",
  "version": "0.1.0",
  "description": "Configurable OpenCode TUI sidebar for inspecting session and harness state.",
  "type": "module",
  "license": "MIT",
  "author": "Aceek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aceek/opencode-harness-panel.git"
  },
  "bugs": {
    "url": "https://github.com/Aceek/opencode-harness-panel/issues"
  },
  "homepage": "https://github.com/Aceek/opencode-harness-panel#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
